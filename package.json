    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop": "./scripts/fetch-tdlib.sh && tauri dev",
    "desktop:build": "./scripts/fetch-tdlib.sh && tauri build",
    "lint": "expo lint",
    "theme:build": "node ./scripts/generate-theme-css.js",
    "tokens:build": "node ./scripts/fetch-token-list.js",
    "tokens:build:solana": "node ./scripts/fetch-solana-tokens.js",
    "pattern:build": "node ./scripts/generate-chat-pattern.js",
    "brand:build": "node ./scripts/trace-brand-mark.js && node ./scripts/generate-brand-assets.js && tauri icon assets/images/icon-desktop.png -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "patch-package && node ./scripts/copy-xmtp-wasm.js",
    "test:e2e": "./e2e/run.sh",
    "test:all": "npm run format:check && npm run typecheck && npm test && npm run test:e2e",
    "setup": "./scripts/setup.sh",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "format": "biome check . --write && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "biome ci . && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@xmtp/react-native-sdk",
          "react-native-tdlib",
          "@unomed/react-native-matrix-sdk"
        ],
        "listUnknownPackages": false
      }
    }
