+/**
+ * Frees the client after TDLib reported authorizationStateClosed. Unlike
+ * `destroy`, this sends nothing to TDLib, so local data is kept.
+ */
+RCT_EXPORT_METHOD(td_json_client_destroy:(RCTPromiseResolveBlock)resolve rejecter:(RCTPromiseRejectBlock)reject) {
+    [self stopReceiveLoop];
+    [_clientLock lock];
+    void *c = _client;
+    _client = NULL;
+    [_clientLock unlock];
+    [self rejectAllPending:@"CLIENT_DESTROYED" message:@"TDLib client was destroyed"];
+    if (c) {
+        td_json_client_destroy(c);
+    }
+    resolve(@"TDLib client destroyed");
+}
